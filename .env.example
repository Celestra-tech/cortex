# CELESTRA Cortex — environment template
# Copy to .env and adjust for local development:  cp .env.example .env
#
# Hostnames below target services running on your machine (pnpm dev / uv run).
# docker-compose.yml overrides connection URLs to use the internal Docker network.

CORTEX_ENV=development
CORTEX_LOG_LEVEL=INFO
# console for humans; json (Cloud Logging shape) is the default in staging/production.
CORTEX_LOG_FORMAT=console
# Reported by /health, logs, metrics, and traces. Set by the deploy scripts.
# CORTEX_RELEASE=
# CORTEX_REVISION=

# ---------------------------------------------------------------------------
# API (FastAPI)
# ---------------------------------------------------------------------------
CORTEX_API_PORT=8000
CORTEX_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reject requests without an API key (`Authorization: Bearer ctx_...`). When false,
# X-Organization-ID alone is accepted, which is only safe for local development.
CORTEX_AUTH_REQUIRE_API_KEY=false
# last_used_at is written at most this often per key.
CORTEX_AUTH_LAST_USED_INTERVAL_SECONDS=60
# Enables POST /v1/admin/organizations (Bearer token, >= 32 characters when deployed).
# Unset, the endpoint does not exist. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# CORTEX_ADMIN_TOKEN=
# Host header allowlist (comma-separated); * accepts any.
CORTEX_API_ALLOWED_HOSTS=*
# Requests with larger bodies get 413. Must exceed CORTEX_KNOWLEDGE_MAX_UPLOAD_BYTES.
CORTEX_API_MAX_REQUEST_BYTES=31457280
CORTEX_SECURITY_HSTS_SECONDS=63072000

# Per API key (or organization) fixed one-minute window in Redis; fails open if Redis
# is down. Organizations can override with settings.rate_limit_per_minute.
CORTEX_RATE_LIMIT_ENABLED=true
CORTEX_RATE_LIMIT_REQUESTS_PER_MINUTE=600

# ---------------------------------------------------------------------------
# Observability
# Prometheus metrics are served on their own port, never on the public API.
# Traces go to an OTLP/HTTP collector (infra/monitoring/docker-compose.monitoring.yml).
# ---------------------------------------------------------------------------
CORTEX_METRICS_ENABLED=true
CORTEX_METRICS_PORT=9464
CORTEX_OTEL_ENABLED=false
CORTEX_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CORTEX_OTEL_SERVICE_NAME=cortex-api
CORTEX_OTEL_SAMPLE_RATIO=1.0
# Links JSON logs to Cloud Trace. Also read from GOOGLE_CLOUD_PROJECT.
# CORTEX_GCP_PROJECT_ID=

# ---------------------------------------------------------------------------
# PostgreSQL 17
# Password must be URL-safe or percent-encoded inside CORTEX_DATABASE_URL.
# ---------------------------------------------------------------------------
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex
POSTGRES_DB=celestra_cortex
POSTGRES_PORT=5432
CORTEX_DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/celestra_cortex
CORTEX_DATABASE_POOL_SIZE=5
CORTEX_DATABASE_MAX_OVERFLOW=10
CORTEX_DATABASE_POOL_TIMEOUT_SECONDS=30
CORTEX_DATABASE_POOL_RECYCLE_SECONDS=1800
CORTEX_DATABASE_STATEMENT_TIMEOUT_MS=30000
CORTEX_DATABASE_ECHO=false

# Database-backed API tests run only when this is set. The name must end in _test:
# the migration test drops and recreates every table.
CORTEX_TEST_DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/celestra_cortex_test

# ---------------------------------------------------------------------------
# Redis 8
# ---------------------------------------------------------------------------
REDIS_PORT=6379
CORTEX_REDIS_URL=redis://localhost:6379/0

# Redis-backed API tests run only when this is set. Must select a non-default
# database; tests delete only their own randomly prefixed keys (never FLUSHDB).
CORTEX_TEST_REDIS_URL=redis://localhost:6379/15

# ---------------------------------------------------------------------------
# Memory
# Hot session window lives in Redis at session:{conversation_id}; every write
# refreshes the TTL. PostgreSQL remains the source of truth.
# ---------------------------------------------------------------------------
CORTEX_MEMORY_SESSION_TTL_SECONDS=86400
CORTEX_MEMORY_SESSION_MAX_MESSAGES=50
CORTEX_MEMORY_SESSION_MAX_TOKENS=8000
CORTEX_MEMORY_RETRIEVAL_HALF_LIFE_DAYS=30

# ---------------------------------------------------------------------------
# Router
# Providers without a key are listed by GET /v1/models but never routed to.
# Keys also load from OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY.
# ---------------------------------------------------------------------------
CORTEX_OPENAI_API_KEY=
CORTEX_ANTHROPIC_API_KEY=
CORTEX_GEMINI_API_KEY=
# CORTEX_OPENAI_BASE_URL=https://api.openai.com/v1
# CORTEX_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# CORTEX_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CORTEX_ROUTER_TIMEOUT_SECONDS=60
CORTEX_ROUTER_MAX_RETRIES=1
CORTEX_ROUTER_FALLBACK_ORDER=openai,anthropic,gemini
CORTEX_ROUTER_DEFAULT_MAX_TOKENS=1024
CORTEX_ROUTER_CIRCUIT_FAILURE_THRESHOLD=3
CORTEX_ROUTER_CIRCUIT_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# Knowledge
# Requires the pgvector extension (docker-compose uses pgvector/pgvector:pg17).
# Embedding providers: local (offline lexical hashing, dev only), openai, gemini.
# openai reuses CORTEX_OPENAI_API_KEY; with a base URL and no key it also works
# against OpenAI-compatible local servers (Ollama, vLLM, LM Studio, TEI).
# gemini reuses CORTEX_GEMINI_API_KEY. Vectors wider than 1536 are not supported.
# Changing provider, model, or dimensions starts a new embedding space:
# re-ingest documents for vector search to find them.
# ---------------------------------------------------------------------------
CORTEX_KNOWLEDGE_EMBEDDING_PROVIDER=local
# CORTEX_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
CORTEX_KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# CORTEX_KNOWLEDGE_EMBEDDING_BASE_URL=http://localhost:11434/v1
CORTEX_KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
CORTEX_KNOWLEDGE_EMBEDDING_MAX_CONCURRENCY=4
CORTEX_KNOWLEDGE_CHUNK_SIZE=512
CORTEX_KNOWLEDGE_CHUNK_OVERLAP=64
# JSON array, tried in order: ["\n\n", "\n", ". ", " "]
# CORTEX_KNOWLEDGE_CHUNK_SEPARATORS=
CORTEX_KNOWLEDGE_MAX_UPLOAD_BYTES=26214400
CORTEX_KNOWLEDGE_TOP_K=8
CORTEX_KNOWLEDGE_RECENCY_WEIGHT=0.1
CORTEX_KNOWLEDGE_RECENCY_HALF_LIFE_DAYS=180
CORTEX_KNOWLEDGE_MAX_CONTEXT_TOKENS=3000

# ---------------------------------------------------------------------------
# Dashboard (Next.js)
# CORTEX_API_URL is used server-side to reach the API.
# CORTEX_API_PUBLIC_URL is the address shown to users.
# ---------------------------------------------------------------------------
DASHBOARD_PORT=3000
DASHBOARD_ENV=development
CORTEX_API_URL=http://localhost:8000
CORTEX_API_PUBLIC_URL=http://localhost:8000
# Encrypts the sign-in session cookie. Required (>= 32 characters) in staging and
# production; development falls back to a fixed local key.
# DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_HOURS=12
NEXT_TELEMETRY_DISABLED=1
